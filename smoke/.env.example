# Copy to smoke/.env (or run: ./smoke/run-smoke.sh --init). Do not use quotes around values.

# spark | dev
SMOKE_PROFILE=spark

# Absolute host path of the platform model directory
MODEL_ROOT=/data/models
# Model directory under MODEL_ROOT used for the smoke test
SMOKE_MODEL_DIR=Qwen2.5-0.5B-Instruct
SMOKE_SERVED_NAME=smoke-qwen
SMOKE_GPU_MEM_UTIL=0.3
SMOKE_MAX_MODEL_LEN=4096

# Empty = use the profile default (spark: pinned eugr/spark-vllm digest; set eugr/spark-vllm:latest to test a newer build)
SMOKE_VLLM_IMAGE=
SMOKE_VLLM_EXTRA_ARGS=
# Empty = profile default
SMOKE_HEALTH_TIMEOUT=
# 1 = also run a deliberate startup-failure probe (safe, small model, tiny memory budget)
SMOKE_ERROR_PROBE=1
# 1 = run vLLM with --ipc=host (only if the default non-privileged run fails)
SMOKE_IPC_HOST=0
# 1 = keep LiteLLM/Postgres running after the test
SMOKE_KEEP_GATEWAY=0

LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:main-stable
LITELLM_BIND=127.0.0.1
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-change-me
LITELLM_SALT_KEY=sk-change-me
POSTGRES_PASSWORD=change-me

# Copy to deploy/.env (or run scripts/init-env.sh). Do not commit deploy/.env.

# spark | dev
DGXSP_PROFILE=spark
DGXSP_VERSION=dev

# Admin token for the Web Console (long random string)
DGXSP_ADMIN_TOKEN=change-me

# Absolute host path of the platform model directory
MODEL_ROOT=/data/models
# Owner of files downloaded from the Web Console (match the owner of MODEL_ROOT: `stat -c '%u %g' /data/models`)
MODEL_OWNER_UID=1000
MODEL_OWNER_GID=1000
# Optional: Hugging Face cache hub directory to scan as an extra source (empty = disabled)
HF_CACHE_DIR=
# Optional: Hugging Face token for gated / private models (can also be set in the Web Console)
HF_TOKEN=
# Optional: Hugging Face mirror, e.g. https://hf-mirror.com (empty = huggingface.co)
HF_ENDPOINT=

# Web Console
WEB_BIND=0.0.0.0
WEB_PORT=8088

# LiteLLM Gateway (external API entry)
GATEWAY_BIND=0.0.0.0
GATEWAY_PORT=4000
# External API base shown to users. Empty = auto-detect from the browser address
# (e.g. opened at http://192.168.50.240:8088 -> http://192.168.50.240:4000/v1).
# Can also be changed in the Web Console: Settings -> External API address.
PUBLIC_API_BASE=
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:main-stable
LITELLM_MASTER_KEY=sk-change-me
LITELLM_SALT_KEY=sk-change-me
POSTGRES_PASSWORD=change-me
